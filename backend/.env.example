# Database Connection URL (PostgreSQL)
#
# Option A — Docker (from project root):
#   docker compose up -d
DATABASE_URL="postgresql://streak:streak@localhost:5433/streak?schema=public"
#
# Option B — Local PostgreSQL:
#   psql -U postgres -c "CREATE DATABASE streak;"
# DATABASE_URL="postgresql://postgres@localhost:5432/streak?schema=public"

# API port
PORT=3000

# REQUIRED for production deploy:
#   NODE_ENV=production
# Enables rate limiting, Helmet security headers, and suppresses SQL query logging.
NODE_ENV=development

# REQUIRED for production deploy:
# Set to your deployed frontend origin (no trailing slash).
# Example: https://streak.vercel.app
CORS_ORIGIN="http://localhost:5173"
