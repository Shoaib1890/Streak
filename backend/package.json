{
  "name": "streak-backend",
  "version": "1.0.0",
  "description": "Backend API server for Streak game",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
