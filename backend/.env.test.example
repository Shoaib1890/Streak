# Test database — isolated from development/production data.
# Copy to .env.test and create the database once before running tests.
#
# Local PostgreSQL:
#   psql -U postgres -c "CREATE DATABASE streak_test;"
# DATABASE_URL="postgresql://postgres@localhost:5432/streak_test?schema=public"
#
# Docker (from project root: docker compose up -d):
#   docker exec streak-db psql -U streak -c "CREATE DATABASE streak_test;"
DATABASE_URL="postgresql://streak:streak@localhost:5433/streak_test?schema=public"
